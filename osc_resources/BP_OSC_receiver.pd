#N canvas 80 80 820 560 12;
#X obj 30 50 netreceive -u -b 7400;
#X obj 30 80 oscparse;
#X obj 30 110 list trim;
#X obj 30 140 route bp;
#X obj 30 170 route note off stop start end;
#X obj 230 230 print BP-note;
#X obj 30 230 unpack f f s f f f f f;
#X obj 200 290 / 127;
#X obj 200 320 * 0.2;
#X obj 120 290 * 1000;
#X obj 30 360 pack f f f;
#X obj 30 390 t l l;
#X msg 130 430 \$2 5 \, 0 50 \$3;
#X obj 130 470 vline~;
#X msg 30 430 \$1;
#X obj 30 470 osc~;
#X obj 30 510 *~;
#X obj 30 540 dac~;
#X msg 400 430 0 20;
#X obj 420 230 print BP;
#X text 230 40 Bol Processor real-time OSC: receives /bp/note \, /bp/off \, /bp/stop \, /bp/start \, /bp/end on UDP port 7400 and plays each note with a sine wave (one note at a time). See ReadMe.txt.;
#X text 260 290 /bp/note id instrument name key freq duration velocity channel [name value]...;
