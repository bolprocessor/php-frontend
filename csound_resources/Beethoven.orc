; String quartet orchestra for "-cs.Beethoven-fugue-b-flat-major"
; Bol Processor BP3, 2026-11-12
;
; Instruments:
;        1    violin    (part 1, first violin)
;        2    viola     (part 3)
;        3    cello     (part 4)
;        4    violin_2  (part 2, second violin: the violin recordings, its own stereo position)
; Effect:
;        Room      concert-hall reverb and peak limiter (outputs to file/speakers)
;
; The instruments play recordings of single notes from the University of Iowa
; Musical Instrument Samples (MIS), violin, viola and cello, arco, 2012 series.
; They are stored as FLAC files in "Iowa_strings/" next to this orchestra:
; every semitone of the range (violin G3-E7, viola C3-A6, cello C2-A5) at three
; dynamics (pp, mf, ff). See Iowa_strings/ReadMe.txt.
; The recordings have no vibrato: it is added by the instruments (see below).
; Each recording is tuned individually (they deviate from equal temperament by
; up to 50 cents), and looped with a crossfade when a note is longer than its sample.
; Beyond the range of its recordings, an instrument borrows those of its neighbour
; (e.g. cello notes above A5 use the viola's A string).
; Slow bow attacks in the recordings are shortened for short notes.
;
; Default instrument parameters used by BP3 (as in 0-default.orc):
;        p2    start time
;        p3    duration
;        p4    pitch in either octave point pitch-class or cps format
;
;    Volume (range 0-127) is supplied by performance control _volume() as
;        p5, p6    beginning & end volumes
;        p7        a table number containing the volume function (or 0)
;    When p7 is positive, the table is used instead of the beginning & end values
;
;    Pitchbend is supplied in cents as
;        p8,p9    beginning & end pitchbend values
;        p10        a table number containing the pitchbend function (or 0)
;    When p10 is positive, the table is used instead of the beginning & end values
;
; Optional parameters (used if the Csound resource file supplies them):
;        p11       attack velocity (_vel(), range 1-127)
;        p12, p13  beginning & end modulation (_mod(), range 0-16383)
;        p14       a table number containing the modulation function (or 0)
;
; Dynamics:
;    The velocity selects the recording (pp below 50, mf from 50 to 95, ff from 96)
;    and sets the level with the MIDI curve (velocity / 127)^2.
;    The volume is a further gain (volume / 90)^2, so the default volume 90 leaves
;    the level unchanged, and _volume() can make crescendos and diminuendos.
;    Without a velocity parameter, the beginning volume (p5) selects the recording
;    and the level is (volume / 127)^2.
;
; Vibrato:
;    Each note gets a natural vibrato: it starts after 60 ms and grows during 350 ms,
;    with a slightly irregular rate and depth. Short notes therefore have almost none.
;    Its depth is set by giVibDepth (in cents, + or -) and its rate by giVibRate (Hz) below.
;    Modulation (_mod) scales the depth: 8192 is the normal depth, 16383 twice
;    as deep, 1 no vibrato. Modulation 0, which BP3 sends when the score contains
;    no _mod(), also gives the normal depth.
;    Pressure is not used.

; This file looks best with a tab size = 4 spaces.

sr = 44100
ksmps = 16
nchnls = 2
0dbfs = 1.0

; Overall level of the notes (adjust if the output is too soft or the limiter works too hard)
giMaxNoteAmp = 0.7

; Settings of each instrument, index 1 to 4: violin, viola, cello, violin_2

; Recordings played by the instrument (1 = violin, 2 = viola, 3 = cello)
giRecordings[] fillarray 0, 1, 2, 3, 1

; Vibrato depth (cents) and rate (Hz)
giVibDepth[] fillarray 0, 16, 15, 13, 15
giVibRate[]  fillarray 0, 5.9, 5.6, 5.3, 5.7

; Stereo position (0 = left, 1 = right), as a quartet is seated from left to right:
; first violin, second violin, viola, cello
giPan[]      fillarray 0, 0.18, 0.60, 0.80, 0.38

; Release time (seconds) after the end of a note
giRelease[]  fillarray 0, 0.10, 0.12, 0.16, 0.10

; Lowest and highest MIDI keys of the recordings (index 1 to 3: violin, viola, cello)
giKeyLow[]   fillarray 0, 55, 48, 36
giKeyHigh[]  fillarray 0, 100, 93, 81

; -- WAVE TABLES --

; A fixed table number is required: "ftgen 0" would give number 101, which BP3 uses
; for the first table of its scores (101, 102, ...), so a score would replace the sine.
giSine    ftgen  99999, 0, 32769, 10, 1    ; sine wave
; Recordings are loaded when first played, as tables 20000 to 21151 (see StringNote)

; Sample map, filled at the end of this file
gSSmpFile[]       init 1152
giSmpPitch[]      init 1152
giSmpLoopStart[]  init 1152
giSmpLoopEnd[]    init 1152
giSmpXfade[]      init 1152
giSmpAttack[]     init 1152
giSmpGain[]       init 1152

; -- BUSES (global audio variables) --

gaDryL    init    0
gaDryR    init    0
gaRevIn   init    0

; -- CREATE EFFECT (held for the whole performance) --

;                     reverb feedback, cutoff, wet level, pre-delay (s)
schedule "Room", 0, -1, 0.82, 9000, 0.30, 0.025

; -- USER DEFINED OPCODES --

; An opcode to convert pitch parameters to cycles per second (cps).
; Parameters less than 15.0 are interpreted as octave.pitchclass format,
; otherwise they are assumed to be frequencies already in cps.
opcode bp_pitch, i, i
ipitchparm    xin

if (ipitchparm < 15.0) then
icps = cpspch(ipitchparm)
else
icps = ipitchparm
endif

xout    icps
endop

; This opcode takes the default BP parameters p3 thru p10 and
; returns two k-rate signals for the instrument's pitch and volume.
opcode bp_control, kk, iiiiiiii
idur, ip4, ip5, ip6, ip7, ip8, ip9, ip10  xin

ik1    = 1.0 / 127.0        ; scale Midi-range volumes (0-127)
ik2    = log(2.) / 1200.    ; constant to convert cents to frequency ratios
icps  bp_pitch  ip4
ifvol = ip7                ; volume table number
ifcents = ip10            ; pitchbend table number

kvol line ip5, idur, ip6
if (ifvol <= 0) goto volumelin
ilenvol = ftlen(ifvol)
kndxvol line 0, idur, ilenvol
kvol tablei kndxvol, ifvol

volumelin:
kcents line ip8, idur, ip9
if (ifcents <= 0) goto pitchbendlin
ilencents = ftlen(ifcents)
kndxcents line 0, idur, ilencents
kcents tablei kndxcents, ifcents

pitchbendlin:
kpitch = icps * exp(kcents * ik2)

xout    kpitch, kvol * ik1
endop

; A parameter given as beginning & end values, or as a table if its number is positive
opcode bp_param, k, iiii
idur, istart, iend, itable  xin
kval line istart, idur, iend
if (itable > 0) then
ilen = ftlen(itable)
kndx line 0, idur, ilen
kval tablei kndx, itable
endif
xout    kval
endop

; One note of a bowed string instrument, played from the recordings
;    iinst: 1 = violin, 2 = viola, 3 = cello, 4 = violin_2
;    idur: duration of the note without its release
;    ivel: attack velocity (0 if not supplied)
;    imod1, imod2, imodtab: modulation (all 0 if not supplied)
opcode StringNote, a, iiiiiiiiiiiiii
iinst, idur, ip4, ip5, ip6, ip7, ip8, ip9, ip10, ivel, imod1, imod2, imodtab, irel  xin

ik2    = log(2.) / 1200.                            ; cents to frequency ratio
icps   bp_pitch  ip4
kpitch, kvol  bp_control  idur, ip4, ip5, ip6, ip7, ip8, ip9, ip10

; dynamics: choice of the recording and level
if (ivel > 0) then
idyn   = ivel
igain  = (ivel / 127) ^ 2
kvolgain = (kvol * 127 / 90) ^ 2
else
idyn   = ip5
igain  = 1
kvolgain = kvol ^ 2
endif
ilayer = (idyn < 50 ? 0 : (idyn < 96 ? 1 : 2))

; the recording nearest to the pitch. Beyond the range of its recordings, an instrument
; borrows those of its neighbour: e.g. cello notes above A5 use the viola's A string.
ikey   = round(69 + 12 * log(icps / 440) / log(2))
imap   = giRecordings[iinst]
while (ikey > giKeyHigh[imap] && imap > 1) do
imap   = imap - 1
od
while (ikey < giKeyLow[imap] && imap < 3) do
imap   = imap + 1
od
ikey   limit  ikey, giKeyLow[imap], giKeyHigh[imap]
idx    = (imap - 1) * 384 + ilayer * 128 + ikey
Sfile  = gSSmpFile[idx]
ifn    ftgenonce  20000 + idx, 0, 0, 1, Sfile, 0, 0, 1
irefcps = 440 * 2 ^ ((giSmpPitch[idx] - 69) / 12)    ; measured pitch of the recording
ils    = giSmpLoopStart[idx]
ile    = giSmpLoopEnd[idx]
ixf    = giSmpXfade[idx]

; Slow bow attacks of the recordings are shortened for short notes:
; the attack may last 70 ms for short notes, up to 310 ms for notes of 2 seconds or more.
iallow = 0.07 + 0.12 * (idur < 2 ? idur : 2)
istart = giSmpAttack[idx] - iallow
istart = (istart > 0 ? istart : 0)
ifadein = (istart > 0 ? 0.008 : 0.003)

; vibrato
imodon = (imod1 != 0 || imod2 != 0 || imodtab > 0 ? 1 : 0)
kmodf  = 1
if (imodon == 1) then
kmod   bp_param  idur, imod1, imod2, imodtab
kmodf  = kmod / 8192
endif
idepth = giVibDepth[iinst] * (0.85 + 0.3 * idyn / 127)  ; a little wider when louder
iphase random 0, 1                                      ; random values differ for each note,
iseed1 random 0, 1                                      ; but are the same each time the score is played
iseed2 random 0, 1
iseed3 random 0, 1
kvibenv linseg 0, 0.06, 0, 0.35, 1                      ; holds 1 after the rise
kvrate = giVibRate[iinst] + randi:k(0.35, 1.7, iseed1)
kvdep  = idepth * (1 + randi:k(0.2, 1.3, iseed2)) * kvibenv * kmodf
kvib   oscili  1, kvrate, giSine, iphase
kdrift randi   2, 0.7, iseed3                           ; slow intonation drift (cents)
kratio = kpitch * exp((kvib * kvdep + kdrift) * ik2) / irefcps
kam    = 1 + 0.004 * kvib * kvdep                       ; amplitude follows the vibrato

asig   flooper2  1, kratio, ils, ile, ixf, ifn, istart
asig   = asig * giSmpGain[idx]

; envelope: fade-in, sustain, release
isus   = idur - ifadein
isus   = (isus > 0.001 ? isus : 0.001)
kenv   transeg  0, ifadein, 0, 1, isus, 0, 1, irel, -3, 0

xout   asig * kenv * kam * igain * kvolgain * giMaxNoteAmp
endop

; -- INSTRUMENTS --

#define STRING_INSTRUMENT(INST) #
idur   = p3
if (idur < 0.01) then           ; BP3 may write notes of duration 0
turnoff
endif
irel   = giRelease[$INST]
p3     = idur + irel
ipc    = pcount()
ivel   = (ipc >= 11 ? p(11) : 0)
imod1  = (ipc >= 12 ? p(12) : 0)
imod2  = (ipc >= 13 ? p(13) : 0)
imodt  = (ipc >= 14 ? p(14) : 0)
asig   StringNote  $INST, idur, p4, p5, p6, p7, p8, p9, p10, ivel, imod1, imod2, imodt, irel
ipan   = giPan[$INST] * $M_PI_2
gaDryL = gaDryL + asig * cos(ipan)
gaDryR = gaDryR + asig * sin(ipan)
gaRevIn = gaRevIn + asig
#

; Violin (first violin)
instr 1
$STRING_INSTRUMENT(1)
endin

; Viola
instr 2
$STRING_INSTRUMENT(2)
endin

; Cello
instr 3
$STRING_INSTRUMENT(3)
endin

; Violin_2 (second violin)
instr 4
$STRING_INSTRUMENT(4)
endin

; -- EFFECT INSTRUMENT --

; Concert-hall reverb and peak limiter
;    p4    feedback level (range 0-1), sets the length of the reverb
;    p5    filter cutoff frequency of the reverb
;    p6    wet level (range 0-1)
;    p7    pre-delay (seconds)
instr Room
ifeedbk = p4
icutoff = p5
iwet   = p6
ipredel = p7

adryl  = gaDryL
adryr  = gaDryR
ain    = gaRevIn
gaDryL = 0
gaDryR = 0
gaRevIn = 0

; the reverb input keeps the stereo position of each instrument only partly,
; and its low end is reduced so that the cello does not sound muddy
ain    butterhp  ain, 120
ain    delay     ain, ipredel
arevl, arevr  reverbsc  ain + 0.5 * adryl, ain + 0.5 * adryr, ifeedbk, icutoff

aoutl  dcblock2  adryl + iwet * arevl
aoutr  dcblock2  adryr + iwet * arevr

; Peak limiter: signals below -6 dBFS (amplitude 0.5) pass unchanged, louder
; peaks are squeezed under 0 dBFS instead of clipping. Both channels share one
; detector so the stereo image does not move during peaks.
; The 50 ms look-ahead delays the whole output by 50 ms.
adetect  max        abs(aoutl), abs(aoutr)
aoutl    compress2  aoutl, adetect, -90, -6, -3, 1000, 0.0002, 0.2, 0.05
aoutr    compress2  aoutr, adetect, -90, -6, -3, 1000, 0.0002, 0.2, 0.05
aoutl    limit      aoutl, -0.99, 0.99    ; safety net for any residual overshoot
aoutr    limit      aoutr, -0.99, 0.99

outs     aoutl, aoutr
endin

; -- SAMPLE MAP --

; Generated from the University of Iowa MIS recordings (see Iowa_strings/ReadMe.txt)
; index = (instrument - 1) * 384 + layer * 128 + MIDI key   (layer 0 = pp, 1 = mf, 2 = ff)
; giSmpPitch = measured pitch of the recording (MIDI key, fractional), giSmpLoopStart/End/Xfade (seconds),
; giSmpAttack = time (s) to reach the steady level, giSmpGain = level correction
gSSmpFile[55] = "Iowa_strings/violin/violin_pp_055_G.flac"
giSmpPitch[55] = 55.020
giSmpLoopStart[55] = 1.27959
giSmpLoopEnd[55] = 2.18000
giSmpXfade[55] = 0.350
giSmpAttack[55] = 0.208
giSmpGain[55] = 1.000
